run_cmd {analyze -format "verilog" $RTL_TOOL_SCRIPT_DIR/../td_ccore_solutions/leading_sign_15_0_1_0_57210b0ad95c4fe954280875fe8f495c6134_0/rtl.v} {analyze file 'rtl.v'}
## Prepare netlist dependencies

run_cmd {analyze -format "verilog" $RTL_TOOL_SCRIPT_DIR/../td_ccore_solutions/leading_sign_11_0_4d0bb2ecabbe24067f655d7d939c3fe25abc_0/rtl.v} {analyze file 'rtl.v'}
## Prepare netlist dependencies

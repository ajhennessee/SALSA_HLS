# written for flow package DesignCompiler 
set sdc_version 1.7 

set_operating_conditions tt0p78v125c
set_wire_load_model -name ForQA
set_wire_load_mode top
set_load 5.17023 [all_outputs]
## driver/slew constraints on inputs
set data_inputs [list {A_d_rsc_0_0_q[*]} {A_d_rsc_0_1_q[*]} {A_d_rsc_0_2_q[*]} {A_d_rsc_0_3_q[*]} {A_d_rsc_0_4_q[*]} {A_d_rsc_0_5_q[*]} {A_d_rsc_0_6_q[*]} {A_d_rsc_0_7_q[*]} {A_d_rsc_0_8_q[*]} {A_d_rsc_0_9_q[*]} {A_d_rsc_0_10_q[*]} {A_d_rsc_0_11_q[*]} {A_d_rsc_0_12_q[*]} {A_d_rsc_0_13_q[*]} {A_d_rsc_0_14_q[*]} {A_d_rsc_0_15_q[*]} {B_d_rsc_0_0_q[*]} {B_d_rsc_1_0_q[*]} {B_d_rsc_2_0_q[*]} {B_d_rsc_3_0_q[*]} {B_d_rsc_4_0_q[*]} {B_d_rsc_5_0_q[*]} {B_d_rsc_6_0_q[*]} {B_d_rsc_7_0_q[*]} {B_d_rsc_8_0_q[*]} {B_d_rsc_9_0_q[*]} {B_d_rsc_10_0_q[*]} {B_d_rsc_11_0_q[*]} {B_d_rsc_12_0_q[*]} {B_d_rsc_13_0_q[*]} {B_d_rsc_14_0_q[*]} {B_d_rsc_15_0_q[*]}]
set_driving_cell -no_design_rule -library saed32lvt_tt0p78v125c -lib_cell DFFX1_LVT -pin Q $data_inputs
set_units -time ns
# time_factor: 1.0

create_clock -name clk -period 1.0 -waveform { 0.0 0.5 } [get_ports {clk}]
set_clock_uncertainty 0.0 [get_clocks {clk}]

create_clock -name virtual_io_clk -period 1.0
## IO TIMING CONSTRAINTS
set_input_delay -clock [get_clocks {clk}] 0.0 [get_ports {rst}]
set_output_delay -clock [get_clocks {clk}] 0.01 [get_ports {A_d_rsc_0_0_radr[*]}]
set_output_delay -clock [get_clocks {clk}] 0.01 [get_ports {A_d_rsc_0_0_re}]
set_input_delay -clock [get_clocks {clk}] 0.5 [get_ports {A_d_rsc_0_0_q[*]}]
set_output_delay -clock [get_clocks {clk}] 0.0 [get_ports {A_d_tri_0_0_osy_lz}]
set_output_delay -clock [get_clocks {clk}] 0.01 [get_ports {A_d_rsc_0_1_radr[*]}]
set_output_delay -clock [get_clocks {clk}] 0.01 [get_ports {A_d_rsc_0_1_re}]
